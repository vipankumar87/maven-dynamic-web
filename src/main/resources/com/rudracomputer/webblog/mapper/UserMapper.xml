<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rudracomputer.webblog.mapper.UserMapper">

    <!-- mapUnderscoreToCamelCase=true handles snake_case -> camelCase automatically -->
    <resultMap id="userMap" type="User">
        <id     property="id"               column="id"/>
        <result property="name"             column="name"/>
        <result property="email"            column="email"/>
        <result property="passwordHash"     column="password_hash"/>
        <result property="role"             column="role"/>
        <result property="createdAt"        column="created_at"/>
        <result property="resetToken"       column="reset_token"/>
        <result property="resetTokenExpiry" column="reset_token_expiry"/>
    </resultMap>

    <!-- ==================== SELECT ==================== -->

    <select id="findById" parameterType="String" resultMap="userMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="findByEmail" parameterType="String" resultMap="userMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="findByResetToken" parameterType="String" resultMap="userMap">
        SELECT * FROM users WHERE reset_token = #{token}
    </select>

    <select id="findAll" resultMap="userMap">
        SELECT * FROM users ORDER BY created_at ASC
    </select>

    <select id="countByRole" parameterType="String" resultType="long">
        SELECT COUNT(*) FROM users WHERE role = #{role}
    </select>

    <select id="countNewToday" resultType="long">
        SELECT COUNT(*) FROM users WHERE DATE(created_at) = CURDATE()
    </select>

    <select id="existsByEmail" parameterType="String" resultType="long">
        SELECT COUNT(*) FROM users WHERE email = #{email}
    </select>

    <!-- ==================== INSERT ==================== -->

    <insert id="insert" parameterType="User">
        INSERT INTO users (id, name, email, password_hash, role, created_at)
        VALUES (#{id}, #{name}, #{email}, #{passwordHash}, #{role}, #{createdAt})
    </insert>

    <!-- ==================== UPDATE ==================== -->

    <update id="updatePassword">
        UPDATE users
        SET password_hash       = #{passwordHash},
            reset_token         = NULL,
            reset_token_expiry  = NULL
        WHERE id = #{id}
    </update>

    <update id="setResetToken">
        UPDATE users
        SET reset_token        = #{resetToken},
            reset_token_expiry = #{resetTokenExpiry}
        WHERE id = #{id}
    </update>

    <update id="clearResetToken" parameterType="String">
        UPDATE users
        SET reset_token        = NULL,
            reset_token_expiry = NULL
        WHERE id = #{id}
    </update>

    <update id="updateRole">
        UPDATE users SET role = #{role} WHERE id = #{id}
    </update>

    <!-- ==================== DELETE ==================== -->

    <delete id="deleteById" parameterType="String">
        DELETE FROM users WHERE id = #{id}
    </delete>

</mapper>
